// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  BUILDING_ADMIN
  MEMBER
}

enum PaymentStatus {
  PAID
  UNPAID
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  OTHER
}

enum ElectricityBillType {
  LIFT
  COMMON_AREA
}

// One row per building/society managed in this app. SUPER_ADMIN profiles have no
// buildingId (buildingId null) and operate across all buildings via a selected-building
// switcher; BUILDING_ADMIN and MEMBER profiles belong to exactly one building.
model Building {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  profiles          Profile[]
  floors            Floor[]
  cleaners          Cleaner[]
  expenseCategories ExpenseCategory[]
  expenses          Expense[]
  electricityBills  ElectricityBill[]
  settings          Settings?
  auditLogs         AuditLog[]

  @@map("buildings")
}

// Mirrors a Supabase auth.users row; authUserId is that user's id.
model Profile {
  id         String   @id @default(uuid())
  authUserId String   @unique
  name       String
  email      String   @unique
  phone      String?
  role       Role     @default(MEMBER)
  isActive   Boolean  @default(true)
  buildingId String?
  createdAt  DateTime @default(now())

  building                Building?            @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  flat                    Flat?                @relation("FlatMember")
  recordedPayments        MaintenancePayment[]   @relation("PaymentRecordedBy")
  recordedCharges         AdditionalCharge[]     @relation("ChargeRecordedBy")
  recordedExpenses        Expense[]              @relation("ExpenseRecordedBy")
  recordedBills           ElectricityBill[]      @relation("BillRecordedBy")
  recordedCleanerPayments CleanerPaymentEntry[]  @relation("CleanerPaymentRecordedBy")
  auditLogs               AuditLog[]             @relation("AuditActor")

  @@map("profiles")
}

model Floor {
  id         String @id @default(uuid())
  buildingId String
  name       String
  sortOrder  Int    @default(0)

  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  flats    Flat[]

  @@map("floors")
}

model Flat {
  id                       String  @id @default(uuid())
  floorId                  String
  flatNumber               String
  monthlyMaintenanceAmount Decimal @db.Decimal(10, 2)
  memberId                 String? @unique

  floor             Floor                @relation(fields: [floorId], references: [id], onDelete: Cascade)
  member            Profile?             @relation("FlatMember", fields: [memberId], references: [id], onDelete: SetNull)
  payments          MaintenancePayment[]
  additionalCharges AdditionalCharge[]
  maintenanceRates  FlatMaintenanceRate[]

  @@unique([floorId, flatNumber])
  @@map("flats")
}

// One row per (flat, month) the maintenance rate changed, effective from that month onward.
model FlatMaintenanceRate {
  id             String   @id @default(uuid())
  flatId         String
  amount         Decimal  @db.Decimal(10, 2)
  effectiveMonth Int // 1-12
  effectiveYear  Int
  createdAt      DateTime @default(now())

  flat Flat @relation(fields: [flatId], references: [id], onDelete: Cascade)

  @@unique([flatId, effectiveMonth, effectiveYear])
  @@map("flat_maintenance_rates")
}

model MaintenancePayment {
  id            String         @id @default(uuid())
  flatId        String
  month         Int // 1-12
  year          Int
  amount        Decimal        @db.Decimal(10, 2)
  status        PaymentStatus  @default(UNPAID)
  paymentDate   DateTime?
  paymentMethod PaymentMethod?
  notes         String?
  recordedById  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  flat       Flat     @relation(fields: [flatId], references: [id], onDelete: Cascade)
  recordedBy Profile? @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([flatId, month, year])
  @@map("maintenance_payments")
}

model AdditionalCharge {
  id           String        @id @default(uuid())
  flatId       String
  description  String
  amount       Decimal       @db.Decimal(10, 2)
  status       PaymentStatus @default(UNPAID)
  dueDate      DateTime?
  paymentDate  DateTime?
  recordedById String?
  createdAt    DateTime      @default(now())

  flat       Flat     @relation(fields: [flatId], references: [id], onDelete: Cascade)
  recordedBy Profile? @relation("ChargeRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@map("additional_charges")
}

model ExpenseCategory {
  id         String @id @default(uuid())
  buildingId String
  name       String

  building Building  @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([buildingId, name])
  @@map("expense_categories")
}

model Expense {
  id           String   @id @default(uuid())
  buildingId   String
  categoryId   String
  description  String
  amount       Decimal  @db.Decimal(10, 2)
  date         DateTime
  recordedById String?
  createdAt    DateTime @default(now())

  building   Building        @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  category   ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  recordedBy Profile?        @relation("ExpenseRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@map("expenses")
}

model ElectricityBill {
  id                 String              @id @default(uuid())
  buildingId         String
  type               ElectricityBillType
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  amount             Decimal             @db.Decimal(10, 2)
  dueDate            DateTime
  status             PaymentStatus       @default(UNPAID)
  paymentDate        DateTime?
  recordedById       String?
  createdAt          DateTime            @default(now())

  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  recordedBy Profile? @relation("BillRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@map("electricity_bills")
}

model Cleaner {
  id            String   @id @default(uuid())
  buildingId    String
  name          String
  monthlySalary Decimal  @db.Decimal(10, 2) // current/latest rate; see CleanerSalaryHistory for per-month rate
  createdAt     DateTime @default(now())

  building      Building               @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  payments      CleanerPayment[]
  salaryHistory CleanerSalaryHistory[]

  @@map("cleaners")
}

// One row per (cleaner, month) the salary rate changed, effective from that month onward.
model CleanerSalaryHistory {
  id             String   @id @default(uuid())
  cleanerId      String
  amount         Decimal  @db.Decimal(10, 2)
  effectiveMonth Int // 1-12
  effectiveYear  Int
  createdAt      DateTime @default(now())

  cleaner Cleaner @relation(fields: [cleanerId], references: [id], onDelete: Cascade)

  @@unique([cleanerId, effectiveMonth, effectiveYear])
  @@map("cleaner_salary_history")
}

// One row per (cleaner, month); the amount due is derived from CleanerSalaryHistory, not stored here.
// Actual money paid is tracked as CleanerPaymentEntry rows underneath, so a month can be paid in parts,
// or a future month's entry recorded early as an advance.
model CleanerPayment {
  id        String   @id @default(uuid())
  cleanerId String
  month     Int // 1-12
  year      Int
  createdAt DateTime @default(now())

  cleaner Cleaner               @relation(fields: [cleanerId], references: [id], onDelete: Cascade)
  entries CleanerPaymentEntry[]

  @@unique([cleanerId, month, year])
  @@map("cleaner_payments")
}

model CleanerPaymentEntry {
  id               String        @id @default(uuid())
  cleanerPaymentId String
  amount           Decimal       @db.Decimal(10, 2)
  paymentDate      DateTime
  paymentMethod    PaymentMethod
  notes            String?
  recordedById     String?
  createdAt        DateTime      @default(now())

  cleanerPayment CleanerPayment @relation(fields: [cleanerPaymentId], references: [id], onDelete: Cascade)
  recordedBy     Profile?       @relation("CleanerPaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@map("cleaner_payment_entries")
}

// One row per building (was a singleton row per deployment before multi-building support).
model Settings {
  id                         String  @id @default(uuid())
  buildingId                 String  @unique
  buildingName               String  @default("My Building")
  openingBalance             Decimal @default(0) @db.Decimal(12, 2)
  allowMembersViewFinancials Boolean @default(false)
  allowMembersViewAllMonths  Boolean @default(false)

  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@map("settings")
}

model AuditLog {
  id         String   @id @default(uuid())
  buildingId String?
  actorId    String?
  action     String
  entityType String
  entityId   String
  details    Json?
  createdAt  DateTime @default(now())

  building Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  actor    Profile?  @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}
